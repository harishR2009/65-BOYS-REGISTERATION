# ═══════════════════════════════════════════
#  65 BOYS — Environment Variables
#  RENAME this file to   .env   before running
# ═══════════════════════════════════════════

# Server port
PORT=3000

# ── Google Sheets Config ─────────────────────────────────
# Your Google Sheet ID (from the URL)
# e.g. https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Service Account credentials (from the JSON key file you download)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Sheet tab name (default: "65 BOYS Registrations")
SHEET_TAB_NAME=65 BOYS Registrations
